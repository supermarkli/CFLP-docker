# Dockerfile for federated learning client 

# FROM python:3.9-slim
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/pytorch/pytorch:latest
# FROM docker.io/pytorch/pytorch:latest

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 彻底修复源和 GPG 问题，并处理空间不足
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives/* && \
    sed -i 's@deb.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list || true && \
    sed -i 's@http://archive.ubuntu.com@http://mirrors.aliyun.com@g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's@http://security.ubuntu.com@http://mirrors.aliyun.com@g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖（增加清理步骤）
RUN apt-get update --allow-insecure-repositories --allow-releaseinfo-change && \
    apt-get install -y --allow-unauthenticated --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# 配置pip使用国内镜像源
# RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 配置pip使用阿里云镜像源
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com


# 只复制必要的文件
COPY requirements.txt requirements.txt
RUN pip install -r requirements.txt && rm requirements.txt
COPY src src


# 设置启动命令
CMD ["python", "src/grpc/client_grpc.py"] 